### Live Helper Chat settings

# Change this hash to your own random string before install
LHC_SECRET_HASH=CHANGE_ME_TO_SOMETHING

# Should webhooks be enabled after install
LHC_WEBHOOKS_ENABLED=1

# Number of workers to use in the script
LHC_RESQUE_WORKERS_COUNT=6

# You can have custom QUEUE which prioritizes specific tasks first
LHC_RESQUE_QUEUE="*"

### DATABASE SETTINGS

MYSQL_ROOT_PASSWORD=lhcroot
MYSQL_DATABASE=lhc
MYSQL_USER=lhc
MYSQL_PASSWORD=lhc

### WEB SETTINGS ###

# On what port we should listen http port.
LHC_PUBLIC_PORT=8081

### NODE JS SETTINGS ###

# This is port for frontend visitors for node js.
LHC_NODE_JS_PORT=8081
REDIS_HOST=redis

# Should online visitors tracked
LHC_NODEJS_TRACK_VISITORS=0

# Should visitors connect to NodeJS in secure way wss

LHC_NODE_JS_SECURE=0

# Redis settings
REDIS_BACKEND=redis:6379
REDIS_BACKEND_DB=1

### GO WEBSOCKET SERVER SETTINGS ###
# Used by the `golhchelper` service (docker-compose-goserver.yml), which replaces the
# NodeJS `nodejshelper` service. It authenticates with SECRET_HASH = LHC_SECRET_HASH
# above, so that value has to match `site.secrethash` of your installed instance.

# Signing key for the browser auth tokens. Leave it empty and every server restart
# invalidates existing tokens - clients transparently call `login` again (this is what
# the old SocketCluster server did). Generate one with: openssl rand -hex 32
# Single quote the value when it contains `$`, otherwise compose mangles it.
#
# NOTE: with more than one server instance this MUST be set and identical everywhere,
# otherwise a token issued by one node is rejected by the other (one extra login).
#AUTH_KEY=

# How much is logged: debug|info|warn|error. `debug` adds one line per websocket
# connect/disconnect - useful while chasing a client that reconnects in a loop.
LOG_LEVEL=info

# Allowed websocket origins, default is everything.
# Example: "example.com:443,example.com:*"
#ORIGINS=*:*

# A visitor token is signed for one specific chat (tokenvisitor.php folds the chat id
# into the hash), so a socket may only subscribe to that chat's channel. Disable this
# only if a client legitimately subscribes to other chat channels - with it off any
# visitor can read any other visitor's chat history.
#STRICT_CHANNEL_BINDING=true

# Refuse `#publish` on channels the socket is not subscribed to. SocketCluster left this
# unrestricted, so it stays off unless your clients only publish inside their own
# channels (typing signals etc.).
#RESTRICT_CLIENT_PUBLISH=false

# Outbound queue per websocket, in messages (~6 KB each at the default). A socket that
# cannot drain it is closed with 1008 and re-syncs through PHP. Lower it when you have a
# very high number of connections.
#SOCKET_SEND_BUFFER=256

# The websocket bus is the REDIS_HOST above, on db 0 (keep that in sync with
# `connect_db_id` in extension/nodejshelper/settings/settings.ini.php). The php-resque
# backend (REDIS_BACKEND/REDIS_BACKEND_DB) is a separate database and unrelated.
#REDIS_PORT=6379
#REDIS_DB=0

# Only when that Redis requires a password / an ACL user (Redis 6+).
#REDIS_PASS=
#REDIS_USER=
